{
  // Static-assets Worker: there is no server code, Cloudflare just serves the
  // files `npm run build` writes into dist/. Having this file also stops
  // `wrangler deploy` from trying to auto-detect a framework setup.
  "name": "portfoliopage",
  "compatibility_date": "2026-09-20",
  "assets": {
    "directory": "./dist"
  },
  // Binding the hostnames here rather than in the dashboard: an assets-only
  // Worker has its trigger settings disabled there. Wrangler creates the
  // custom domain and the DNS records on deploy.
  "routes": [
    { "pattern": "vkazmenko.com", "custom_domain": true },
    { "pattern": "www.vkazmenko.com", "custom_domain": true }
  ]
}
